    "@tanstack/react-query": "^5.62.11",
    "axios": "^1.7.9",
    "expo": "^57.0.0",
    "expo-constants": "~57.0.16",
    "expo-dev-client": "~57.0.16",
    "expo-font": "~57.0.2",
