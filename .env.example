# Supabase — auth (email OTP) + the `profiles` table. See docs/SUPABASE_AUTH.md.
# URL: project origin only, e.g. https://xxxx.supabase.co (no /rest/v1 path).
# KEY: the publishable key (sb_publishable_...). NEVER the secret / service_role key.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional: force a specific JobIn backend base URL (defaults to the Metro host in
# dev, or the production API). See src/shared/services/api.ts.
# EXPO_PUBLIC_API_URL=
